--config_plugin=filesystem
--config_path=/etc/osquery/osquery.conf
--logger_plugin=tls
--logger_tls_endpoint=/log
--logger_tls_period=${OSQUERY_TLS_PERIOD}
--logger_min_status=2
--tls_hostname=${OSQUERY_GATEWAY}
--tls_server_certs=${OSQUERY_CERT_DIR}/ca.crt
--tls_client_cert=${OSQUERY_CERT_DIR}/client.crt
--tls_client_key=${OSQUERY_CERT_DIR}/client.key
--disable_enrollment=true
--host_identifier=specified
--specified_identifier=${OSQUERY_HOST_IDENTIFIER}
--utc=true
--disable_events=true
--database_path=/var/osquery/osquery.db
--pidfile=/var/osquery/osqueryd.pidfile
--force=true
